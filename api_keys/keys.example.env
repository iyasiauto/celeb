# Copy to api_keys/keys.env (git-ignored) and fill in the values, or set the same names as
# environment variables / secrets. Names only here - never put a real key in this file.

# Voiceover for Docu Studio: FameSpeak (ElevenLabs voices) - famespeak.online/api-keys
FAMESPEAK_API_KEY=

# Keys in your Frontier folder's .env (Settings -> Frontier folder) are found too; no need to repeat them here.

# AI editor / vision - all optional (Settings -> AI picks the provider). OpenAI-compatible:
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat
OPENLUX_API_KEY=
# OPENLUX_MODEL=gemini-2.5-flash-lite
# Antigravity / Gemini account through a local model router (cli-proxy-api):
# ANTIGRAVITY_BASE_URL=http://127.0.0.1:8317/v1
ANTIGRAVITY_API_KEY=
# Any other OpenAI-compatible server:
# CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
# Claude API (optional; the Claude Code CLI uses your plan instead) - console.anthropic.com
ANTHROPIC_API_KEY=

# Voiceover: TwoSpeaker / ElevenLabs-style TTS used by pipeline.py (--api-key)
TWOSPEAKER_API_KEY=

# Online footage (optional, make_video.py --online / docu/tools/fetch_online.py)
# Pexels (free): https://www.pexels.com/api/   Pixabay (free): https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Google Images through serper.dev (licence unknown - off unless you add 'google' to --sources)
SERPER_API_KEY=

# Delivery: gofile account token (optional). With it, uploads go into your gofile account
# instead of anonymous links, so they don't expire as quickly. gofile.io -> My profile -> API token
GOFILE_TOKEN=

# Add any new service the same way: SERVICE_API_KEY=
