# Copy to api_keys/keys.env (git-ignored) and fill in the values, or set the same names as
# environment variables / secrets. Names only here - never put a real key in this file.

# Voiceover: TwoSpeaker / ElevenLabs-style TTS used by pipeline.py (--api-key)
TWOSPEAKER_API_KEY=

# Delivery: gofile account token (optional). With it, uploads go into your gofile account
# instead of anonymous links, so they don't expire as quickly. gofile.io -> My profile -> API token
GOFILE_TOKEN=

# Add any new service the same way: SERVICE_API_KEY=
