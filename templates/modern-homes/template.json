 "audit": {
  "clip_share": [
   0.2,
   0.75
  ],
  "graphics_per_min": 0.7,
  "max_gap_s": 75,
  "max_plain_run": 8,
  "chapter_every_s": 210,
  "min_distinct_devices": 5,
  "sfx_per_min": 1.0
 },
 "devices": [
  {
   "type": "doc_dateline",
   "family": "graphic",
   "min_per_10min": 1.5,
   "use": "a new place or time begins: PLACE, a gold rule, the date (over the blurred real picture)"
  },
  {
   "type": "doc_number",
   "family": "graphic",
   "min_per_10min": 1.2,
   "use": "one figure that matters, counting up, its unit, what it means and its source"
  },
  {
   "type": "doc_chart",
   "family": "graphic",
   "min_per_10min": 0.6,
   "use": "a comparison with real numbers: 2-6 bars on warm paper, the one that matters highlighted, source under"
  },
  {
   "type": "doc_timeline",
   "family": "graphic",
   "min_per_10min": 0.6,
   "use": "3-5 dated events on a line the camera travels along"
  },
  {
   "type": "doc_quote",
   "family": "graphic",
   "min_per_10min": 0.5,
   "use": "a documented quote, word by word, with who said it and when"
  },
  {
   "type": "doc_pivot",
   "family": "graphic",
   "min_per_10min": 0.8,
   "use": "one short serif line where the story turns"
  },
  {
   "type": "doc_question",
   "family": "graphic",
   "min_per_10min": 0.5,
   "use": "the question the next part answers"
  },
  {
   "type": "doc_card",
   "family": "graphic",
   "min_per_10min": 0.3,
   "use": "a short card of key lines, the words that matter highlighted"
  },
  {
   "type": "doc_step",
   "family": "graphic",
   "min_per_10min": 0,
   "use": "one numbered step of a process"
  },
  {
   "type": "doc_social",
   "family": "graphic",
   "min_per_10min": 0,
   "use": "a follow / unfollow between two public accounts"
  },
  {
   "type": "doc_chapter",
   "family": "heading",
   "min_per_10min": 3,
   "use": "the chapter card: number, kicker, title"
  },
  {
   "type": "doc_place",
   "family": "graphic",
   "min_per_10min": 1,
   "use": "a place name card (city, region)"
  },
  {
   "type": "doc_pull",
   "family": "graphic",
   "min_per_10min": 0.6,
   "use": "a real sentence from a real article with outlet, byline and date"
  },
  {
   "type": "doc_table",
   "family": "graphic",
   "min_per_10min": 0.4,
   "use": "a small table of real figures with its source"
  },
  {
   "type": "map",
   "family": "map",
   "min_per_10min": 0.2,
   "use": "where it happens (the template's map colours)"
  },
  {
   "type": "spotlight",
   "family": "photo",
   "min_per_10min": 0.2,
   "use": "a real photo of a person named, in a pool of light"
  },
  {
   "type": "depth",
   "family": "photo",
   "min_per_10min": 0.4,
   "use": "a 2.5D push into a still"
  }
 ],
 "also_available": [
  "photo",
  "clip",
  "map",
  "depth",
  "spotlight"
 ],
 "frontier": {
  "style": "modern-homes",
  "kind": "docgfx",
  "kit": "",
  "frame": null,
  "frame_every": 0
 },
 "rules": [
  "Every graphic shows a real fact the voice gives at that moment (a name, a date, a place, a figure, a quote) - times come from the word timing, never before the narrator says it.",
  "Footage: clips under 5 s, chained when a line is longer; no talking heads, influencers or logos (QC).",
  "This look puts the presenter in a rounded card over warm paper with the title underneath, so the presenter is ticked by default. Generated clips are off — real product pictures and graphics do the work."
 ],
 "qc_mode": "faceless",
 "guide": "templates/modern-homes/README.md",
 "captions": {
  "font": "Montserrat ExtraBold",
  "size": 74,
  "upper": false,
  "karaoke": false,
  "box": true,
  "outline": 0.42,
  "outline_colour": "&H2E12100E",
  "shadow": 0.0,
  "line_chars": 28,
  "margin_v": 62
 },
 "caption_accent": "&H3C50C0&"
}